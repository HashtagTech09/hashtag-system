# Copy to .env.local (git-ignored) and fill in real values.
# Only VITE_-prefixed vars are read by the app (see src/integrations/supabase).
# These values are shipped to the browser, so use the Supabase *publishable/anon* key only.
#
# NEVER put the Supabase service role key here or in any VITE_ var.
# Edge Functions receive SUPABASE_SERVICE_ROLE_KEY automatically from Supabase.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PROJECT_ID=<project-ref>
VITE_SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-or-anon-key>
